{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "bagent",
  "title": "bagent",
  "description": "Ouvre un workspace bagent dans VSCode, Claude Code ou Codex",
  "icon": "icon.png",
  "author": "damienpugin",
  "license": "MIT",
  "commands": [
    {
      "name": "open-workspace",
      "title": "bagent",
      "description": "Liste et ouvre tes workspaces bagent",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "terminal",
      "title": "Terminal (Claude/Codex)",
      "description": "Application terminal utilisée pour ouvrir Claude Code et Codex",
      "type": "dropdown",
      "required": false,
      "default": "Terminal",
      "data": [
        {
          "title": "Terminal.app",
          "value": "Terminal"
        },
        {
          "title": "iTerm",
          "value": "iTerm"
        }
      ]
    },
    {
      "name": "bagentPath",
      "title": "Binaire bagent",
      "description": "Chemin du binaire bagent (vide = ~/.local/bin/bagent)",
      "type": "textfield",
      "required": false,
      "default": ""
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.80.0",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "@types/react": "^19.0.0"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
